generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(EDITOR)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  newsArticles  NewsArticle[]
  videos        Video[]
  announcements Announcement[]
  pressReleases PressRelease[]
}

model NewsArticle {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String
  body        String
  coverImage  String?
  category    String        @default("General")
  status      ContentStatus @default(DRAFT)
  featured    Boolean       @default(false)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  author      User          @relation(fields: [authorId], references: [id])
  authorId    String

  @@index([status, publishedAt])
  @@index([category])
}

model Video {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String
  youtubeId   String
  thumbnail   String?
  category    String        @default("Programs")
  status      ContentStatus @default(DRAFT)
  featured    Boolean       @default(false)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  uploader    User          @relation(fields: [uploaderId], references: [id])
  uploaderId  String
  program     Program?      @relation(fields: [programId], references: [id])
  programId   String?

  @@index([status, publishedAt])
  @@index([category])
}

model Program {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  dayOfWeek   String?
  time        String?
  coverImage  String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  videos      Video[]
}

model GalleryAlbum {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?
  eventDate   DateTime?
  coverImage  String?
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  images      GalleryImage[]
}

model GalleryImage {
  id        String       @id @default(cuid())
  url       String
  caption   String?
  order     Int          @default(0)
  album     GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumId   String
  createdAt DateTime     @default(now())
}

model Announcement {
  id          String        @id @default(cuid())
  title       String
  body        String
  priority    Int           @default(0)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  author      User          @relation(fields: [authorId], references: [id])
  authorId    String
}

model PressRelease {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  summary     String
  body        String
  documentUrl String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  author      User          @relation(fields: [authorId], references: [id])
  authorId    String
}

model LiveStream {
  id          String   @id @default(cuid())
  title       String
  youtubeId   String
  isLive      Boolean  @default(false)
  scheduledAt DateTime?
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  token     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SiteSettings {
  id                String  @id @default("singleton")
  emergencyPhone    String?
  emergencyEmail    String?
  facebookUrl       String?
  twitterUrl        String?
  instagramUrl      String?
  youtubeUrl        String?
  tiktokUrl         String?
}
