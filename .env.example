# Database (Supabase / Neon / any managed Postgres connection string)
DATABASE_URL="postgresql://user:password@host:5432/npftv?schema=public"

# NextAuth
NEXTAUTH_URL="https://npftv.net"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Seed script (first admin account — change password after first login)
SEED_ADMIN_EMAIL="admin@npftv.net"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Media storage (image/video uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# EmailJS — powers the contact form's team notification + auto-reply,
# and the newsletter subscribe confirmation email. All values here are
# safe to expose to the browser (that's how EmailJS's client SDK works)
# — set them up at https://www.emailjs.com
# Without these set, forms still work and still save to the database —
# they just won't send emails (logged to the console instead).
NEXT_PUBLIC_EMAILJS_SERVICE_ID=""
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=""
NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=""
NEXT_PUBLIC_EMAILJS_AUTOREPLY_TEMPLATE_ID=""
NEXT_PUBLIC_EMAILJS_SUBSCRIBE_TEMPLATE_ID=""
